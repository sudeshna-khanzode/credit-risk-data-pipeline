# ─────────────────────────────────────────────────────────────────
# .env.example — copy to .env and adjust as needed.
# Every value here overrides the default in app/core/config.py.
# ─────────────────────────────────────────────────────────────────

# App metadata (shown in Swagger UI at /docs)
APP_TITLE=Credit Risk Data Pipeline
APP_VERSION=1.0.0

# Data source
HF_DATASET_URL=https://huggingface.co/datasets/scikit-learn/credit-card-clients/resolve/main/UCI_Credit_Card.csv
HF_DATASET_NAME=scikit-learn/credit-card-clients

# ETL tunables
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# Persistence — SQLite file the LOAD step writes to.
# Inside Docker this is set to /app/data/credit_risk.db (see docker-compose.yml).
DB_PATH=data/credit_risk.db

# Logging
LOG_LEVEL=INFO
